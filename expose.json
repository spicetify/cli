{
  "version": 1,
  "patches": [
    {
      "name": "Expose PlatformAPI",
      "pattern": "((?:setTitlebarHeight|registerFactory)[\\w(){}<>:.,&$!=;\"\"?!#%/\\- ]+)(\\{version:[a-zA-Z_\\$][\\w\\$]*,)",
      "replace": "${1}Spicetify._platform=${2}",
      "once": false,
      "onMiss": "warn",
      "hits": {
        "1.2.84": 1,
        "1.2.96": 1
      }
    },
    {
      "name": "Redux store",
      "pattern": "return(\\(0,[\\w$]+\\.[\\w$]+\\)\\(\\(0,[\\w$]+\\.[\\w$]+\\)\\(\\{(?s:.{0,1500}?)\\)\\}\\(\\{session:[\\w$]+,features:[\\w$]+,seoExperiment:[\\w$]+\\},\\{platform:)",
      "replace": "return Spicetify.Platform.ReduxStore=${1}",
      "once": true,
      "onMiss": "warn",
      "hits": {
        "1.2.84": 0,
        "1.2.96": 1
      },
      "note": "The store is created inside an IIFE invoked with the session/features/seoExperiment object; this anchors on the only `return (0,createStore)((0,combineReducers)({` in that IIFE and routes the created store through the global. 1.2.84 builds the store another way and has no seoExperiment key at all, so ReduxStore is not exposed there yet."
    },
    {
      "name": "React Component: Platform Provider",
      "pattern": "(,[$\\w]+=)((function\\([\\w$]{1}\\)\\{var [\\w$]+=[\\w$]+\\.platform,[\\w$]+=[\\w$]+\\.children,)|(\\(\\{platform:[\\w$]+,children:[\\w$]+\\}\\)=>\\{))",
      "replace": "${1}Spicetify.ReactComponent.PlatformProvider=${2}",
      "once": false,
      "onMiss": "warn",
      "hits": {
        "1.2.84": 0,
        "1.2.96": 2
      }
    },
    {
      "name": "Spotify Custom Snackbar Interface",
      "pattern": "\\b\\w\\s*\\(\\)\\s*[^;,]*enqueueCustomSnackbar:\\s*(\\w)\\s*[^;]*;",
      "replace": "${0}Spicetify.Snackbar.enqueueCustomSnackbar=${1};",
      "once": false,
      "onMiss": "warn",
      "hits": {
        "1.2.84": 1,
        "1.2.96": 1
      }
    },
    {
      "name": "Spotify Image Snackbar Interface",
      "pattern": "return(\\(0,[\\w$]+\\.useCallback\\)\\(\\(\\{message:[\\w$]+,\\s*imageSrc)",
      "replace": "return Spicetify.Snackbar.enqueueImageSnackbar=${1}",
      "once": false,
      "onMiss": "warn",
      "hits": {
        "1.2.84": 1,
        "1.2.96": 1
      },
      "note": "The enqueue arrow is returned through useCallback rather than assigned."
    },
    {
      "name": "React Component: Navigation for navLinks",
      "pattern": "(;const [\\w\\d]+=)((?:\\(0,[\\w\\d]+\\.memo\\))[\\(\\d,\\w\\.\\){:}=]+=[\\d\\w]+\\.[\\d\\w]+\\.getLocaleForURLPath\\(\\))",
      "replace": "${1}Spicetify.ReactComponent.Navigation=${2}",
      "once": true,
      "onMiss": "quiet",
      "hits": {
        "1.2.84": 1,
        "1.2.96": 0
      },
      "note": "The wrapper finds Navigation through webpack at runtime (react-components.js), so a miss is covered."
    },
    {
      "name": "Context Menu V2",
      "pattern": "(\"Menu\".+?children:)([\\w$][\\w$\\d]*)",
      "replace": "${1}[Spicetify.ContextMenuV2.renderItems(),${2}].flat()",
      "once": false,
      "onMiss": "warn",
      "hits": {
        "1.2.84": 1,
        "1.2.96": 1
      }
    },
    {
      "name": "Map styled-components classes",
      "pattern": "(\\w+ [\\w$_]+)=[\\w$_]+\\([\\w$_]+>>>0\\)",
      "replace": "${1}=Spicetify._getStyledClassName(arguments,this)",
      "once": false,
      "onMiss": "warn",
      "hits": {
        "1.2.84": 1,
        "1.2.96": 1
      }
    },
    {
      "name": "Tippy.js",
      "pattern": "([\\w\\$_]+)\\.setDefaultProps=",
      "replace": "Spicetify.Tippy=${1};${0}",
      "once": false,
      "onMiss": "warn",
      "hits": {
        "1.2.84": 2,
        "1.2.96": 2
      }
    },
    {
      "name": "Flipper components",
      "pattern": "([\\w$]+)=((?:function|\\()([\\w$.,{}()= ]+(?:springConfig|overshootClamping)){2})",
      "replace": "${1}=Spicetify.ReactFlipToolkit.spring=${2}",
      "once": false,
      "onMiss": "quiet",
      "hits": {
        "1.2.84": 1,
        "1.2.96": 0
      },
      "note": "react-flip-toolkit left the client in 1.2.9x; nothing remains to expose there."
    },
    {
      "name": "Snackbar",
      "pattern": "\\w+\\s*=\\s*\\w\\.call\\(this,[^)]+\\)\\s*\\|\\|\\s*this\\)\\.enqueueSnackbar",
      "replace": "Spicetify.Snackbar=${0}",
      "once": false,
      "onMiss": "warn",
      "hits": {
        "1.2.84": 1,
        "1.2.96": 1
      }
    }
  ]
}
